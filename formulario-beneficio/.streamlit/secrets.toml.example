# Copiar como .streamlit/secrets.toml (local) o pegar en Settings > Secrets de Streamlit Cloud
admin_password = "cambiar-esta-clave"

[sheets]
# El ID es la parte de la URL entre /d/ y /edit
spreadsheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# Contenido del JSON de la cuenta de servicio de Google Cloud
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "formulario@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
